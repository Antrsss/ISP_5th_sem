@page
@model WEB_353502_ZGIRSKAYA.UI.Areas.Admin.Pages.Cocktails.CreateModel

@{
    ViewData["Title"] = "Create";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Cocktail</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Cocktail.Name" class="form-label"></label>
                <input asp-for="Cocktail.Name" class="form-control" />
                <span asp-validation-for="Cocktail.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cocktail.Description" class="form-label"></label>
                <textarea asp-for="Cocktail.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Cocktail.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SelectedCategoryId" class="form-label">Category</label>
                <select asp-for="SelectedCategoryId" class="form-control">
                    <option value="">-- Select Category --</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="SelectedCategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cocktail.Price" class="form-label"></label>
                <input asp-for="Cocktail.Price" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Cocktail.Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Image" class="form-label">Изображение коктейля</label>
                <input asp-for="Image" class="form-control" type="file" accept="image/*" />
                <div class="form-text">Выберите изображение для коктейля (JPG, PNG, GIF)</div>
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create
                </button>
                <a asp-page="./Index" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>