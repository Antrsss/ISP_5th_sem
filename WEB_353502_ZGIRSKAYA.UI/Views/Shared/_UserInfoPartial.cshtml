@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    // Получаем информацию о пользователе из claims
    var name = User.Claims.FirstOrDefault(c => c.Type.Equals("preferred_username", StringComparison.OrdinalIgnoreCase))?.Value;
    var avatar = User.Claims.FirstOrDefault(c => c.Type.Equals("avatar", StringComparison.OrdinalIgnoreCase))?.Value;

    // Если аватар не найден, используем изображение по умолчанию
    var avatarUrl = !string.IsNullOrEmpty(avatar) ? avatar : "~/images/default-profile-picture.png";
}

@if (User.Identity.IsAuthenticated)
{
    <!-- Пользователь вошел в систему -->
    <div class="d-flex align-items-center ms-auto">
        @await Component.InvokeAsync("Cart")

        <div class="dropdown ms-4 nav-color">
            <button class="btn btn-secondary dropdown-toggle"
                    type="button" id="dropdownMenuButton"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                @name
                <img src="@Url.Content(avatarUrl)" width="30"
                     alt="User" class="rounded nav-color" />
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                <li>
                    <span class="dropdown-item-text">
                        <img src="@Url.Content(avatarUrl)"
                             width="50" alt="User" class="rounded" />
                        @name
                    </span>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                        <button id="logout" type="submit" class="nav-link btn-link text-dark">
                            Logout
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
}
else
{
    <div class="d-flex align-items-center ms-auto">
        <a class="btn btn-primary me-2" asp-controller="Account" asp-action="Login">Login</a>
        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">Register</a>
    </div>
}