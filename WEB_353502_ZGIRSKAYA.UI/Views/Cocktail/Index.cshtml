@model WEB_353502_ZGIRSKAYA.Domain.Models.ListModel<WEB_353502_ZGIRSKAYA.Domain.Entities.Cocktail>

@{
    ViewData["Title"] = "Cocktails Catalog";
    var currentCategory = ViewData["CurrentCategory"]?.ToString();
}

<div class="container">
    <h1>@ViewData["Title"]</h1>

    <div class="row">
        <div class="col-md-3">
            <div class="dropdown" id="category-dropdown">
                <button class="btn btn-secondary dropdown-toggle"
                        type="button"
                        id="categoryDropdownButton"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    Cocktail categories
                </button>
                <ul class="dropdown-menu" aria-labelledby="categoryDropdownButton">
                    <li class="nav-item">
                        <a class="nav-link @(string.IsNullOrEmpty(currentCategory) ? "active" : "")"
                           asp-controller="Cocktail"
                           asp-route-category=""
                           asp-route-pageNo="1">
                            All cocktails
                        </a>
                    </li>
                    @if (ViewData["Categories"] != null)
                    {
                        @foreach (var category in ViewData["Categories"] as IEnumerable<CocktailCategory>)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentCategory == category.NormilisedName ? "active" : "")"
                                   asp-controller="Cocktail"
                                   asp-route-category="@category.NormilisedName"
                                   asp-route-pageNo="1">
                                    @category.Name
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-link text-muted">Categories not loaded</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="col-md-9">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <div id="cocktail-content">
                <partial name="_CocktailListPartial" model="Model" />
            </div>
        </div>
    </div>
</div>