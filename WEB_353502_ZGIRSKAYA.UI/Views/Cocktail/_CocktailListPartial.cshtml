@model WEB_353502_ZGIRSKAYA.Domain.Models.ListModel<WEB_353502_ZGIRSKAYA.Domain.Entities.Cocktail>

@{
    var request = ViewContext.HttpContext.Request;
    var returnUrl = request.Path + request.QueryString.ToUriComponent();
    var currentCategory = ViewData["CurrentCategory"]?.ToString();
}

@if (Model.Items.Any())
{
    <div class="row row-cols-1 row-cols-md-3 g-4" id="cocktail-list">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(item.PathToPicture))
                    {
                        <img src="@item.PathToPicture"
                             class="card-img-top"
                             alt="@item.Name"
                             style="height: 200px; object-fit: cover;"
                             onerror="this.onerror=null; this.src='https://localhost:7002/Images/noimage.jpg';">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-white">No image</span>
                        </div>
                    }

                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted">@item.Description</p>
                        <p class="text-muted small">Category: @(item.Category?.Name ?? "No category")</p>
                    </div>

                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="h5 mb-0 text-primary">@item.Price.ToString("C")</span>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a asp-controller="Cart"
                                   asp-action="Add"
                                   asp-route-id="@item.Id"
                                   asp-route-returnUrl="@returnUrl"
                                   class="btn btn-success btn-sm"
                                   title="Add @item.Name to cart">
                                    <i class="fas fa-cart-plus"></i> Add to cart
                                </a>
                            }
                            else
                            {
                                <a asp-area="Identity"
                                   asp-page="/Account/Login"
                                   asp-route-returnUrl="@returnUrl"
                                   class="btn btn-outline-success btn-sm"
                                   title="Login to add to cart">
                                    <i class="fas fa-sign-in-alt"></i> Login to buy
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="Cocktail"
                       asp-route-category="@currentCategory"
                       asp-route-pageNo="@(Model.CurrentPage == 1 ? 1 : Model.CurrentPage - 1)">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Cocktail"
                           asp-route-category="@currentCategory"
                           asp-route-pageNo="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="Cocktail"
                       asp-route-category="@currentCategory"
                       asp-route-pageNo="@(Model.CurrentPage == Model.TotalPages ? Model.TotalPages : Model.CurrentPage + 1)">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="alert alert-info">
        <h4>No cocktails found</h4>
        <p>There are no cocktails available@(!string.IsNullOrEmpty(currentCategory) ? " in this category" : "").</p>
    </div>
}