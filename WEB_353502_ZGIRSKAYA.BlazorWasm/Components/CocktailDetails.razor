@using WEB_353502_ZGIRSKAYA.BlazorWasm.Models

<div class="cocktail-details mt-4">
    @if (SelectedCocktail != null)
    {
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">
                    <span class="oi oi-info" aria-hidden="true"></span>
                    Подробная информация
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        @if (!string.IsNullOrEmpty(SelectedCocktail.PathToPicture))
                        {
                            <img src="@SelectedCocktail.PathToPicture"
                                 class="img-fluid rounded"
                                 alt="@SelectedCocktail.Name"
                                 style="max-height: 300px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <span class="oi oi-image text-muted" style="font-size: 3rem;"></span>
                            </div>
                        }
                    </div>
                    <div class="col-md-8">
                        <h4 class="text-primary">@SelectedCocktail.Name</h4>

                        <div class="mb-3">
                            <span class="badge bg-secondary">@SelectedCocktail.CategoryName</span>
                            @if (SelectedCocktail.AlcoholPercentage.HasValue)
                            {
                                <span class="badge bg-warning ms-1">@SelectedCocktail.AlcoholPercentage% алкоголя</span>
                            }
                            @if (SelectedCocktail.VolumeMl.HasValue)
                            {
                                <span class="badge bg-info ms-1">@SelectedCocktail.VolumeMl мл</span>
                            }
                        </div>

                        <p class="card-text">@SelectedCocktail.Description</p>

                        @if (!string.IsNullOrEmpty(SelectedCocktail.Ingredients))
                        {
                            <div class="mb-3">
                                <h6>
                                    <span class="oi oi-list-rich" aria-hidden="true"></span>
                                    Ингредиенты:
                                </h6>
                                <p class="text-muted">@SelectedCocktail.Ingredients</p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(SelectedCocktail.PreparationMethod))
                        {
                            <div class="mb-3">
                                <h6>
                                    <span class="oi oi-wrench" aria-hidden="true"></span>
                                    Способ приготовления:
                                </h6>
                                <p class="text-muted">@SelectedCocktail.PreparationMethod</p>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <div>
                                <span class="oi oi-tag" aria-hidden="true"></span>
                                <strong class="h5 text-primary">@SelectedCocktail.Price.ToString("C")</strong>
                            </div>
                            <button class="btn btn-outline-secondary" @onclick="ClearSelection">
                                <span class="oi oi-x" aria-hidden="true"></span>
                                Закрыть
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center text-muted">
                <span class="oi oi-arrow-top" aria-hidden="true" style="font-size: 2rem;"></span>
                <p class="mt-2">Выберите коктейль из списка для просмотра подробной информации</p>
            </div>
        </div>
    }
</div>